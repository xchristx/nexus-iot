# Copiar a .env y completar con los datos de la app WEB del proyecto Firebase
# (Configuración del proyecto > General > Tus apps > la app web > SDK setup:
# "Config"). Ver firebase/LEEME.md.
#
# Estos valores son PUBLICOS por diseño y terminan dentro del bundle: la API
# key de Firebase identifica al proyecto, no da permisos. Lo que protege los
# datos son las reglas (firebase/database.rules.json).
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=TUPROYECTO.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://TUPROYECTO-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=TUPROYECTO
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Solo para pruebas locales contra los emuladores (cd firebase && npm run emuladores):
# VITE_USAR_EMULADOR=1
